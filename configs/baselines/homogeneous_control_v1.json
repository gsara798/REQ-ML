{
  "schema_name": "reqml_baseline_config",
  "schema_version": "1.0",
  "baseline_id": "homogeneous_control_v1",
  "dataset": {
    "dataset_id": "homogeneous_projected3d_control_v2",
    "examples_mat": "outputs/datasets/homogeneous_projected3d_control_v2/examples.mat",
    "target_column": "q_target_from_center_truth"
  },
  "split": {
    "method": "grouped_condition_holdout",
    "group_columns": [
      "campaign_background_cs_m_s",
      "campaign_frequency_hz",
      "campaign_direction_count"
    ],
    "run_column": "campaign_run_id",
    "seed": 4101,
    "train_fraction": 0.70,
    "validation_fraction": 0.15,
    "test_fraction": 0.15
  },
  "models": [
    "fixed_q",
    "context_only",
    "ridge_full",
    "bagged_full"
  ],
  "primary_metrics": [
    "q_mae",
    "q_rmse",
    "q_bias",
    "sws_median_ape",
    "sws_mape",
    "sws_bias_percent"
  ],
  "map_diagnostics": {
    "enabled": true,
    "selected_test_runs": 3,
    "selection_rule": "one representative run from low, intermediate, and high direction count",
    "outputs": [
      "q_target_map",
      "q_pred_map",
      "q_error_map",
      "cs_true_map",
      "cs_pred_map",
      "cs_error_percent_map",
      "central_patch_power_spectrum",
      "central_patch_radial_spectrum",
      "central_patch_cumulative_energy"
    ]
  }
}
