{
  "schema_name": "reqml_angular_aperture_N20_config",
  "schema_version": "1.0",
  "study_id": "angular_aperture_N20_v1",

  "paths": {
    "simulation_framework_root": "${SWSIM_ROOT}",
    "simulation_base_config": "${SWSIM_ROOT}/configs/swsynth/scientific/reqml_eikonal_training_v1/homogeneous_base.json",
    "output_root": "${REPOSITORY_ROOT}/outputs/validation/angular_aperture_N20_v1"
  },

  "design": {
    "cs_m_s": [2.0, 3.0],
    "frequency_hz": 500,
    "direction_count": 20,

    "in_plane_count": [0, 1, 2, 5],

    "solid_angle_fraction": [
      0.0007957747154594767,
      0.01,
      0.04,
      0.0625,
      0.125,
      0.1875,
      0.25,
      0.3125,
      0.375,
      0.4375,
      0.5,
      0.5625,
      0.625,
      0.6875,
      0.75,
      0.8125,
      0.875,
      0.9375,
      1.0
    ],

    "realizations_per_condition": 3,
    "base_seed": 102001,
    "condition_seed_stride": 100
  },

  "wavefield": {
    "propagation_model": "projected3d_eikonal",
    "direction_space": "three_dimensional",
    "sampling_method": "fibonacci",
    "support_type": "solid_angle_cap",
    "support_axis_xyz": [1.0, 0.0, 0.0],
    "phase_policy": "random_uniform",
    "polarization_model": "transverse_random",
    "amplitude_jitter_fraction": 0.05,
    "snr_db": 1000
  },

  "req": {
    "M_values": [2, 3],
    "cs_guess_m_s": 3.0,
    "step_pixels": 2
  },

  "analysis": {
    "compute_q_oracle": true,
    "compute_q_pred": true,
    "compute_q_theory": false
  }
}
